# Reference values for backend process environment variables.
# This file is not loaded automatically by the Python application.
# RUNTIME_PROFILE is the authoritative selector; SCHEMA_PROVIDER remains a legacy alias.
# Supported values are CLIENT_GCP, PERSONAL_GCP, and LOCAL.
RUNTIME_PROFILE=CLIENT_GCP
GOOGLE_CLOUD_PROJECT=mos-gcp-host-dev-prj
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# Used only in LOCAL mode; CLIENT_GCP always uses GOOGLE_CLOUD_PROJECT as before.
# GEMINI_PROJECT_ID=personal-gemini-project-id

# Legacy alias for RUNTIME_PROFILE; omit when RUNTIME_PROFILE is set.
# SCHEMA_PROVIDER=CLIENT_GCP
# Required only when RUNTIME_PROFILE=LOCAL; never points to credentials.
# LOCAL_SCHEMA_BACKUP_PATH=/approved/encrypted/local/metadata-backup

# Defaults to GOOGLE_CLOUD_PROJECT when omitted.
# BIGQUERY_PROJECT_ID=mos-gcp-host-dev-prj
BIGQUERY_DATASET_ID=dw_nsp_api_views
BIGQUERY_TABLE_ID=nsp_base_view_01
BIGQUERY_MAX_BYTES_PROCESSED=262144000

# PERSONAL_GCP execution is disabled unless BOTH explicit opt-in values are supplied.
# These flags do not create credentials or change cloud IAM.
# RUNTIME_PROFILE=PERSONAL_GCP
# PERSONAL_GCP_PROJECT_ID=personal-project-id
# PERSONAL_GEMINI_PROJECT_ID=personal-project-id
# PERSONAL_BIGQUERY_PROJECT_ID=personal-project-id
# PERSONAL_GCP_GEMINI_CREDENTIALS_FILE=/secure/path/gemini-credentials.json
# PERSONAL_GCP_BIGQUERY_CREDENTIALS_FILE=/secure/path/bigquery-credentials.json
# PERSONAL_GCP_EXECUTION_ENABLED=false
# PERSONAL_GCP_EXECUTION_CONFIRM_PROJECT=personal-project-id
# When execution is explicitly approved, both values must be set: true and the exact project ID.
# PERSONAL_GCP_EXECUTION_ENABLED=true
# PERSONAL_GCP_EXECUTION_CONFIRM_PROJECT=mos-gcp-host-dev-prj-512311
# PERSONAL_GCP_GEMINI_LOCATION=global
# PERSONAL_GCP_BIGQUERY_LOCATION=US
# PERSONAL_GCP_ALLOWED_DATASETS=approved_reporting,approved_reference
# PERSONAL_GCP_DATASET_MAPPINGS={"client_dataset":"personal_dataset"}
# PERSONAL_GCP_ALLOWED_TABLES={"personal_dataset":["approved_table"]}
# PERSONAL_GCP_ALLOWED_VIEWS={"personal_dataset":["approved_view"]}
# Required for every allowlisted table/view; column names may be Unicode, including Arabic.
# PERSONAL_GCP_ALLOWED_COLUMNS_JSON={"personal_dataset.approved_table":[{"name":"column_name","data_type":"STRING","nullability":"NULLABLE"}]}
# PERSONAL_GCP_VIEW_DEFINITIONS_JSON={"personal_dataset.approved_view":"SELECT column_name FROM `personal-project.personal_dataset.approved_table`"}
# PERSONAL_GCP_DEFAULT_DATASET_ID=approved_reporting
# PERSONAL_GCP_DEFAULT_TABLE_ID=approved_table

# Optional BigQuery job location for CLIENT_GCP/LOCAL (PERSONAL_GCP uses PERSONAL_GCP_BIGQUERY_LOCATION).
# BIGQUERY_LOCATION=US
# Server-side BigQuery job timeout. Unset: none for CLIENT_GCP/LOCAL; PERSONAL_GCP is always <= 60.
# BIGQUERY_JOB_TIMEOUT_SECONDS=60
# Gemini limits. Unset keeps CLIENT_GCP/LOCAL unchanged; PERSONAL_GCP defaults to 4096 / 60 / 8.
# GEMINI_MAX_OUTPUT_TOKENS=4096
# GEMINI_REQUEST_TIMEOUT_SECONDS=60
# GEMINI_MAX_CALLS_PER_REQUEST=8
# PERSONAL_GCP per-process limits. In-memory only: they reset on restart and are not shared across
# workers or instances, so they are NOT durable spending caps. Use GCP budgets and BigQuery quotas too.
# PERSONAL_GCP_MAX_GEMINI_CALLS_PER_PROCESS=200
# PERSONAL_GCP_MAX_BIGQUERY_JOBS_PER_PROCESS=100
# PERSONAL_GCP_MAX_BIGQUERY_BYTES_PER_PROCESS=1048576000
# PERSONAL_GCP endpoints accept loopback clients only unless remote access is enabled with a token.
# PERSONAL_GCP_ALLOW_REMOTE_CLIENTS=false
# PERSONAL_GCP_API_TOKEN=<at least 32 random characters; never commit>
# PERSONAL_GCP_RATE_LIMIT_PER_MINUTE=10